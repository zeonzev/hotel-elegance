# Copie este archivo como .env SOLO si su MySQL no usa los valores por defecto de XAMPP.
# Sin archivo .env el sistema usa: 127.0.0.1:3306, usuario root, sin contraseña.

DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=hotel_elegance
DB_USUARIO=root
DB_CLAVE=

# Muestra el detalle de los errores (sólo para desarrollo)
APP_DEBUG=false

# Minutos de inactividad antes de cerrar la sesión
SESION_INACTIVIDAD=120
